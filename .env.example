# ============================================================
# 환경 변수 예시 — 실제 배포 시 .env 파일을 복사해 값을 채우세요.
# .env 파일은 Git에 커밋하지 마세요. (.gitignore에 포함 권장)
# ============================================================

# 카카오 네이티브 앱 키 (Kakao Developers에서 발급받은 키)
# https://developers.kakao.com/console/app 에서 앱 생성 후 발급
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here

# API 서버 베이스 URL (예: https://your-api.com/api)
API_BASE_URL=https://your-api.com/api

# WebSocket 베이스 URL (TLS, wss://). 리버스 프록시가 443에서 끊으면 포트 생략 예: wss://kinover.shop
# 예전 ws:// 값은 앱에서 wss://로 바꿉니다.
WS_CHAT_BASE_URL=wss://your-ws-host
WS_CHAT_BASE_URL=wss://your-ws-host

# 카카오 네이티브 앱 키 (Android manifest 등 네이티브에서 사용)
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here

# 필요 시 추가 (외부 API 키 등은 배포 시 별도 .env.production 등으로 관리)
# EXT_API_KEY=

# --- App Store 심사 (전화 OTP) ---
# Firebase Console → Authentication → Sign-in method → 전화 → "전화번호 인증용 테스트"
# 에 심사용 번호와 고정 6자리 코드를 등록한 뒤, App Store Connect → 앱 심사 정보 →
# "메모"에 동일한 번호·코드를 적으면 심사관이 추가 전화 없이 진행할 수 있습니다.

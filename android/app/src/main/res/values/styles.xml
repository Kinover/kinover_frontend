<resources>
<style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
  <item name="android:windowNoTitle">true</item>

  <!-- ✅ 시스템바를 투명하게 하지 않음 (edge-to-edge 끄는 효과) -->
  <item name="android:statusBarColor">@android:color/white</item>
  <item name="android:navigationBarColor">@android:color/white</item>

  <!-- ✅ 시스템바 배경을 OS가 정상 처리 -->
  <item name="android:windowDrawsSystemBarBackgrounds">true</item>

  <!-- ✅ 하단 네비게이션 바 영역 침범 방지: 투명/침범 금지 → JS에서 수동 패딩만으로 맞추면 됨 -->
  <item name="android:windowTranslucentNavigation">false</item>

  <!-- (선택) 대비 강제는 일단 기본값으로 두는 게 안정적 -->
  <!-- <item name="android:enforceNavigationBarContrast">true</item> -->
  <!-- <item name="android:enforceStatusBarContrast">true</item> -->
</style>

<style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
  <item name="android:windowBackground">@android:color/white</item>
  <item name="android:windowNoTitle">true</item>

  <item name="android:statusBarColor">@android:color/white</item>
  <item name="android:navigationBarColor">@android:color/white</item>
  <item name="android:windowDrawsSystemBarBackgrounds">true</item>

  <!-- ✅ 하단바 침범 방지 -->
  <item name="android:windowTranslucentNavigation">false</item>
</style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- REST API는 HTTPS만 허용, WebSocket(ws://:9090)은 cleartext 필요 -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">kinover.shop</domain>
  </domain-config>
  <!-- Metro bundler 개발용 — 릴리즈 빌드에서는 사용되지 않음 -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">43.200.47.242</domain>
  </domain-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
